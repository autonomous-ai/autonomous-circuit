#: (ledger #, what it prevents, file, regex that must *not* match)
#: These pin copy-elimination lessons where the regression is the return of a
#: duplicated literal rather than the disappearance of one implementation.
FORBIDDEN_FIX_PATTERNS: list[tuple[int, str, str, str]] = [
    (
        21,
        "the project skeleton must not impose an unverified router effort",
        "skills/circuitcode/templates/project_skeleton/boards/main.tsx",
        r"autorouterEffortLevel",
    ),
    (
        15,
        "Hydrate must not re-copy the pour cutout number",
        "examples/hydrate-coaster/boards/main.tsx",
        r"cutoutMargin\s*=\s*['\"]0\.25mm['\"]",
    ),
    (
        15,
        "the USB-C block guide must point at the shared constant",
        "packages/golden-blocks/blocks/usb-c-power/BLOCK.md",
        r"cutoutMargin\s*=\s*['\"]0\.25mm['\"]",
    ),
    (
        15,
        "the USB-C review must point at the shared constant",
        "packages/golden-blocks/blocks/usb-c-power/REVIEW.md",
        r"cutoutMargin\s*=\s*['\"]0\.25mm['\"]",
    ),
]


def open_entries() -> list[tuple[str, str]]:
    """Parse the Open table out of the ledger, so the two cannot drift."""
    text = (REPO / "docs" / "lessons.md").read_text()
    try:
        section = text.split("## Open —", 1)[1].split("## The rule", 1)[0]
    except IndexError:
        return []
    rows = []
    for line in section.splitlines():
        line = line.strip()
        if not line.startswith("|") or line.startswith("|---") or "Defect" in line:
            continue
        cells = [c.strip() for c in line.strip("|").split("|")]
        if len(cells) >= 4 and cells[0].isdigit():
            defect = re.sub(r"\*\*", "", cells[1])
            where = cells[3].split(".")[0].replace("**", "")
            rows.append((defect[:96], where))
    return rows


def closed_ids() -> set[int]:
    """Parse every numeric row in the Closed table.

    The checker used to verify only the hand-maintained claim list. A new
    Closed row could therefore have no ratchet at all and CI would stay green.
    Requiring set equality makes adding a ledger row and adding its executable
    proof one atomic change.
    """
    text = (REPO / "docs" / "lessons.md").read_text()
    try:
        section = text.split("## Closed —", 1)[1].split("## Open —", 1)[0]
    except IndexError:
        return set()
    ids: set[int] = set()
    for line in section.splitlines():
        line = line.strip()
        if not line.startswith("|") or line.startswith("|---") or "Defect" in line:
            continue
        cells = [c.strip() for c in line.strip("|").split("|")]
        if cells and cells[0].isdigit():
            ids.add(int(cells[0]))
    return ids


def main() -> int:
    print("Claimed fixes — is each one still in the tree?\n")
    missing = 0
    ledger_ids = closed_ids()
    claimed_ids = {num for num, *_ in CLAIMED_FIXES + FORBIDDEN_FIX_PATTERNS}
    for num in sorted(ledger_ids - claimed_ids):
        print(f"  MISSING  #{num}  closed ledger row has no executable ratchet")
        missing += 1
    for num in sorted(claimed_ids - ledger_ids):
        print(f"  MISSING  #{num}  ratchet claims a defect that is not Closed")
        missing += 1
    for num, what, rel, pattern in sorted(CLAIMED_FIXES):
        path = REPO / rel
        if not path.exists():
            print(f"  MISSING  #{num}  {what}\n           file is gone: {rel}")
            missing += 1
            continue
        if re.search(pattern, path.read_text()):
            print(f"  ok       #{num}  {what}")
        else:
            print(f"  MISSING  #{num}  {what}\n           {rel} no longer matches /{pattern}/")
            missing += 1

    for num, what, rel, pattern in sorted(FORBIDDEN_FIX_PATTERNS):
        path = REPO / rel
        if not path.exists():
            print(f"  MISSING  #{num}  {what}\n           file is gone: {rel}")
            missing += 1
            continue
        if re.search(pattern, path.read_text()):
            print(f"  MISSING  #{num}  {what}\n           {rel} unexpectedly matches /{pattern}/")
            missing += 1
        else:
            print(f"  ok       #{num}  {what}")

    rows = open_entries()
    if rows:
        print(f"\nOpen — detected but a user can still hit these ({len(rows)}):\n")
        for defect, where in rows:
            print(f"  open     {defect}")
            print(f"           belongs in: {where}")

    print()
    if missing:
        print(f"FAIL — {missing} claimed fix(es) are not in the tree.")
        print("Either restore the fix or move its ledger entry back to Open.")
        return 1
    verified = len(CLAIMED_FIXES) + len(FORBIDDEN_FIX_PATTERNS)
    print(f"PASS — {verified} fixes verified, {len(rows)} defects still open.")
    if rows:
        print("Open defects are not failures. They are the backlog that decides")
        print("whether the next user's board hits what these three boards taught us.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
