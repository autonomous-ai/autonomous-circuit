        "the hole rule exempts the hole's own net, and the corpus pins it both ways",
        "packages/circuitpy/tests/test_failure_corpus.py",
        r"hole-rule-applied-to-the-hole-s-own-pad",
    ),
    (
        25,
        "the router halo does not push a connector away from the board edge",
        "skills/circuitcode/circuitlib/layout.py",
        r"face = EDGE_MARGIN_MM if edge else margin",
    ),
    (
        26,
        "footprint IoU is not graded through a rotation the metric cannot see",
        "packages/circuitpy/tests/test_failure_corpus.py",
        r"footprint-iou-graded-through-a-rotation",
