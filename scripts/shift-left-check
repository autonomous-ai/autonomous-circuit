#!/usr/bin/env python3
"""Verify every fix the defect ledger claims is actually in the tree.

Run: scripts/shift-left-check   (exit 1 if a claimed fix is missing)

`docs/lessons.md` records every blocking defect we have hit and where the fix
landed. A ledger nobody checks rots: a fix gets reverted during a refactor, or
was never really landed, and the entry keeps claiming otherwise. This asserts
each one against the source.

It also prints the open defects — the ones that are currently *detected* but
not yet impossible. Detection is a smoke alarm, not a fix: a defect we only
find afterwards is one every user pays a build cycle for, forever. The count of
open entries is the honest measure of how much of what these three boards
taught us has actually reached the platform.
"""

from __future__ import annotations

import re
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent

#: (ledger #, what it prevents, file, regex that must match)
#: The regex is the *proof* the fix is present. Keep it specific enough that a
#: revert breaks it and loose enough that a rename does not.
CLAIMED_FIXES: list[tuple[int, str, str, str]] = [
    (
        1,
        "USB-C alignment drills are inside a keepout the router must respect",
        "packages/golden-blocks/blocks/usb-c-power/usb-c-power.tsx",
        r"<keepout",
    ),
    (
        2,
        "pour hole-margin is derived from the 32-gon chord, not guessed",
        "packages/golden-blocks/blocks/glue.tsx",
        r"POUR_CUTOUT_MARGIN_MM",
    ),
    (
        7,
        "a new project's first board uses MountingHole, which carries a keepout",
        "skills/circuitcode/templates/project_skeleton/boards/main.tsx",
        r"<MountingHole",
    ),
    (
        3,
        "placement plans from measured block boxes, not assumed-centred sizes",
        "skills/circuitcode/circuitlib/layout.py",
        r"def place_board",
    ),
    (
        4,
        "a routing-class failure retries at higher router effort",
        "packages/circuitpy/src/circuitpy/generation.py",
        r"autorouterEffortLevel",
    ),
    (
