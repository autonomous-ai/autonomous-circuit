#: (ledger #, what it prevents, glob, regex that must NOT appear anywhere)
#: The other half of a landed fix: a constant only has one owner while nobody
#: writes the number down again. #15 was three copies of 0.25mm.
BANNED_LITERALS: list[tuple[int, str, str, str]] = [
    (
        15,
        "the pour margin is never a copied literal — one owner, POUR_CUTOUT_MARGIN_MM",
        "**/*.tsx",
        r'cutoutMargin="0\.\d+mm"',
    ),
    (
        29,
        "no board or block ties both pads of a switch terminal — the diagonal "
        "shape is what makes a wrong pad-pairing survivable",
        "**/sw-tact/sw-tact.tsx",
        r"TR_\$\{sw\}_p[23]",
    ),
    (
        33,
        "no golden block closes a polygon pad's ring — a repeated first/last "
        "vertex is a zero-length edge, and every via then reads as inside it",
        "packages/golden-blocks/**/*.tsx",
        r'points=\{\[\{ x: "([^"]+)", y: "([^"]+)" \}[^\]]*'
        r'\{ x: "\1", y: "\2" \}\]\}',
    ),
]


def open_entries() -> list[tuple[str, str]]:
    """Parse the Open table out of the ledger, so the two cannot drift."""
    text = (REPO / "docs" / "lessons.md").read_text()
    try:
        section = text.split("## Open —", 1)[1].split("## The rule", 1)[0]
    except IndexError:
        return []
    rows = []
    for line in section.splitlines():
        line = line.strip()
        if not line.startswith("|") or line.startswith("|---") or "Defect" in line:
            continue
        cells = [c.strip() for c in line.strip("|").split("|")]
        if len(cells) >= 4 and cells[0].isdigit():
            defect = re.sub(r"\*\*", "", cells[1])
            where = cells[3].split(".")[0].replace("**", "")
            rows.append((defect[:96], where))
    return rows


def main() -> int:
    print("Claimed fixes — is each one still in the tree?\n")
    missing = 0
    for num, what, rel, pattern in sorted(CLAIMED_FIXES):
        path = REPO / rel
        if not path.exists():
            print(f"  MISSING  #{num}  {what}\n           file is gone: {rel}")
            missing += 1
            continue
        if re.search(pattern, path.read_text()):
            print(f"  ok       #{num}  {what}")
        else:
            print(f"  MISSING  #{num}  {what}\n           {rel} no longer matches /{pattern}/")
            missing += 1

    for num, what, glob, pattern in BANNED_LITERALS:
        hits = [
            path for path in sorted(REPO.glob(glob))
            if "node_modules" not in path.parts and ".circuit" not in path.parts
            and re.search(pattern, path.read_text(errors="replace"))
        ]
        if hits:
            print(f"  BACK     #{num}  {what}")
            for path in hits:
                print(f"           {path.relative_to(REPO)} matches /{pattern}/")
            missing += 1
        else:
            print(f"  ok       #{num}  {what}")

    rows = open_entries()
    if rows:
        print(f"\nOpen — detected but a user can still hit these ({len(rows)}):\n")
        for defect, where in rows:
            print(f"  open     {defect}")
            print(f"           belongs in: {where}")

    print()
    if missing:
        print(f"FAIL — {missing} claimed fix(es) are not in the tree.")
        print("Either restore the fix or move its ledger entry back to Open.")
        return 1
    print(f"PASS — {len(CLAIMED_FIXES)} fixes verified, {len(rows)} defects still open.")
    if rows:
        print("Open defects are not failures. They are the backlog that decides")
        print("whether the next user's board hits what these three boards taught us.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
