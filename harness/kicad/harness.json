{
  "spec": 1,
  "id": "autonomous/kicad",
  "name": "KiCad",
  "category": "PCB",
  "author": "Autonomous",
  "formerly": [
    "autonomous/solder"
  ],
  "description": "Describe a board; get a real KiCad project — a wired schematic, DRC-checked copper, a prototype packet — with a live board view.",
  "engine": "codex",
  "workspace": {
    "template": "template",
    "marker": "project.json",
    "init": "toolchain/init-workspace.sh"
  },
  "agent": {
    "instructions": "AGENTS.md",
    "skills": [
      "skills"
    ],
    "env": {
      "KICAD_HARNESS_PYTHON": "${dsh}/toolchain/python",
      "KICAD_HARNESS_ROOT": "${dsh}/../..",
      "KICAD_HARNESS_BLOCKS": "${dsh}/../../packages/golden-blocks/blocks",
      "CIRCUIT_TOOLCHAIN": "${dsh}/../../toolchain",
      "KICAD_HARNESS_PICO_SDK": "${dsh}/../../toolchain/pico/pico-sdk",
      "KICAD_HARNESS_ARM_TOOLCHAIN": "${dsh}/../../toolchain/pico/arm-gnu-toolchain",
      "PICO_SDK_PATH": "${dsh}/../../toolchain/pico/pico-sdk",
      "PICO_TOOLCHAIN_PATH": "${dsh}/../../toolchain/pico/arm-gnu-toolchain",
      "CMAKE_PREFIX_PATH": "${dsh}/../../toolchain/pico/picotool",
      "KICAD_HARNESS_CMAKE": "${dsh}/../../toolchain/pico/tools/bin/cmake",
      "KICAD_HARNESS_NINJA": "${dsh}/../../toolchain/pico/tools/bin/ninja",
      "CIRCUIT_SKILLS_DIR": "${workspace}/.agents/skills",
      "DISABLE_AUTOUPDATER": "1"
    },
    "args": [
      "-m",
      "gpt-6-astra",
      "-c",
      "model_reasoning_effort=high",
      "-c",
      "approval_policy=never",
      "-c",
      "sandbox_mode=danger-full-access",
      "-c",
      "hooks.Stop=[{hooks=[{type=\"command\",command=\"\\\"$KICAD_HARNESS_PYTHON\\\" -m kicadpy.autofinish\",timeout=1200}]}]",
      "-c",
      "hooks.Interrupt=[{hooks=[{type=\"command\",command=\"\\\"$KICAD_HARNESS_PYTHON\\\" -m kicadpy.autofinish\",timeout=3}]}]"
    ]
  },
  "toolchain": {
    "setup": "toolchain/setup.sh",
    "doctor": "toolchain/doctor.sh"
  },
  "viewer": {
    "command": "toolchain/viewer.sh",
    "url": "http://127.0.0.1:${port}/"
  },
  "verdict": ".harness/verdict.json"
}
