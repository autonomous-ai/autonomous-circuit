{
  "spec": 1,
  "id": "autonomous/solder",
  "name": "Solder",
  "category": "PCB",
  "author": "Autonomous",
  "description": "Describe a board; get a KiCad-native PCB — a real schematic, DRC-checked copper, a prototype packet — with a live board view.",
  "engine": "claude",
  "workspace": {
    "template": "template",
    "marker": "project.json",
    "init": "toolchain/init-workspace.sh"
  },
  "agent": {
    "instructions": "AGENTS.md",
    "skills": ["skills"],
    "env": {
      "SOLDER_PYTHON": "${dsh}/toolchain/python",
      "SOLDER_ROOT": "${dsh}/../..",
      "SOLDER_BLOCKS": "${dsh}/../../packages/golden-blocks/blocks",
      "CIRCUIT_TOOLCHAIN": "${dsh}/../../toolchain",
      "CIRCUIT_SKILLS_DIR": "${workspace}/.claude/skills",
      "DISABLE_AUTOUPDATER": "1"
    }
  },
  "toolchain": {
    "setup": "toolchain/setup.sh",
    "doctor": "toolchain/doctor.sh"
  },
  "viewer": {
    "command": "toolchain/viewer.sh",
    "url": "http://127.0.0.1:${port}/"
  },
  "verdict": ".harness/verdict.json"
}
