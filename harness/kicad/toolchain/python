#!/usr/bin/env bash
# Solder's Python: a host Python >= 3.10 with kicadpy and circuitpy on its path.
#
# Every Solder command is `"$SOLDER_PYTHON" -m kicadpy ...` — this script IS $SOLDER_PYTHON. It
# resolves the interpreter the same way the pipeline does (CIRCUIT_PYTHON wins, then the newest
# python3.x on PATH that is >= 3.10), puts the checkout's packages on PYTHONPATH, points
# circuitpy at the pinned toolchain (Freerouting jar + JRE), and execs. It never installs anything.
#
# This is the HOST Python. KiCad's bundled Python (pcbnew) is a different runtime — kicadpy finds
# it itself (`kicadpy.toolchain.executable('python')`); never import pcbnew here.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
py=""
for cand in "${CIRCUIT_PYTHON:-}" python3.13 python3.12 python3.11 python3.10 python3; do
  [ -n "$cand" ] || continue
  resolved="$(command -v "$cand" 2>/dev/null || true)"
  [ -n "$resolved" ] || continue
  if "$resolved" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null; then
    py="$resolved"; break
  fi
done
if [ -z "$py" ]; then
  echo "solder: no python >= 3.10 on PATH (brew install python@3.12, or set CIRCUIT_PYTHON)" >&2
  exit 127
fi
export PYTHONPATH="$ROOT/packages/kicadpy/src:$ROOT/packages/circuitpy/src${PYTHONPATH:+:$PYTHONPATH}"
export CIRCUIT_TOOLCHAIN="${CIRCUIT_TOOLCHAIN:-$ROOT/toolchain}"
exec "$py" "$@"
