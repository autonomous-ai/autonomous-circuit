(pcb tiny
  (parser (string_quote ") (space_in_quoted_tokens on) (host_cad "autonomous-circuit") (host_version "1.8"))
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu (type signal) (property (index 0)))
    (layer B.Cu (type signal) (property (index 1)))
    (boundary (path pcb 0 -100000 -100000 100000 -100000 100000 100000 -100000 100000 -100000 -100000))
    (keepout k1 (polygon signal 0 -20000 75000 20000 75000 20000 85000 -20000 85000))
    (keepout mount (circle signal 26000 80000 -80000))
    (via Via[0-1]_600:300_um)
    (rule (width 2000) (clearance 1500) (clearance 1500 (type default_smd)) (clearance 1500 (type smd_smd)))
  )
  (placement
    (component IMG_p1 (place p1 0 0 front 0))
    (component IMG_p2 (place p2 0 0 front 0))
    (component IMG_p3 (place p3 0 0 front 0))
    (component IMG_p4 (place p4 0 0 front 0))
    (component IMG_p5 (place p5 0 0 front 0))
  )
  (library
    (image IMG_p1 (pin PS0 1 -50000 0))
    (image IMG_p2 (pin PS1 1 50000 0))
    (image IMG_p3 (pin PS2 1 -50000 50000))
    (image IMG_p4 (pin PS2 1 50000 50000))
    (image IMG_p5 (pin PS3 1 0 -50000))
    (padstack PS0 (shape (polygon F.Cu 0 -5000 -3000 5000 -3000 5000 3000 -5000 3000)) (attach off))
    (padstack PS1 (shape (polygon F.Cu 0 3000 -5000 3000 5000 -3000 5000 -3000 -5000)) (attach off))
    (padstack PS2 (shape (circle F.Cu 12000)) (shape (circle B.Cu 12000)) (attach off))
    (padstack PS3 (shape (polygon B.Cu 0 -5000 -5000 5000 -5000 5000 5000 -5000 5000)) (attach off))
    (padstack Via[0-1]_600:300_um (shape (circle F.Cu 6000)) (shape (circle B.Cu 6000)) (attach off))
  )
  (network
    (net n_gnd (pins p3-1 p4-1))
    (net n_sig (pins p1-1 p2-1))
    (class default n_sig (circuit (use_via Via[0-1]_600:300_um)) (rule (width 2000) (clearance 1500)))
    (class power n_gnd (circuit (use_via Via[0-1]_600:300_um)) (rule (width 5000) (clearance 1500)))
  )
  (wiring)
)
