{
  "spec": 1,
  "id": "autonomous/copper",
  "name": "Copper",
  "category": "PCB",
  "formerly": [
    "autonomous/circuit"
  ],
  "description": "Describe a board; get a fab-ready PCB with a live board view, ordered from JLCPCB in a click.",
  "engine": "claude",
  "workspace": {
    "template": "harness/template",
    "marker": "product.json",
    "init": "harness/toolchain/init-workspace.sh"
  },
  "agent": {
    "instructions": "harness/AGENTS.md",
    "skills": [
      "skills"
    ],
    "env": {
      "CIRCUIT_TOOLCHAIN": "${dsh}/toolchain",
      "CIRCUIT_SKILLS_DIR": "${workspace}/.claude/skills",
      "DISABLE_AUTOUPDATER": "1"
    }
  },
  "toolchain": {
    "setup": "harness/toolchain/setup.sh",
    "doctor": "harness/toolchain/doctor.sh"
  },
  "viewer": {
    "command": "harness/toolchain/viewer.sh",
    "url": "http://127.0.0.1:${port}/"
  },
  "verdict": ".harness/verdict.json"
}
